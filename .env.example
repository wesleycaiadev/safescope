# SafeScope — Environment Variables
# Copy to .env and fill in values

# Database (SQLite for dev, postgresql:// for production)
DATABASE_URL=sqlite:///./safescope.db

# Auth
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_SECRET=change-me-to-another-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Platform mode
SAFESCOPE_MODE=development

# Supabase production authentication. The publishable key is allowed in the
# dashboard; never put a service_role/secret key in NEXT_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SAFESCOPE_API=https://api.example.com

# Worker
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_ID=worker-local-01

# Canary (for blind XSS/SSRF callbacks)
CANARY_BASE_URL=http://localhost:8888

# ZAP (optional)
ZAP_API_KEY=
ZAP_PROXY_URL=http://localhost:8080

# Nuclei (optional)
NUCLEI_TEMPLATES_PATH=
